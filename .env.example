# Booking form → GoHighLevel pipeline
# Set these on the Vercel project (Project → Settings → Environment Variables).
# Without them, the booking form still works — submissions are written to
# Vercel runtime logs as a backstop — but they won't reach GHL.

# Sub-account location id for the client
GHL_LOCATION_ID=

# Private Integration token scoped to that sub-account.
# Create at: HighLevel → Sub-account → Settings → Private Integrations →
#   Create Private Integration
# Required scopes: contacts.write, contacts/notes.write, contacts/tags.write
GHL_LOCATION_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Generate-Site pipeline secrets (set on the GH Actions repo, not Vercel)
# Only needed if you're regenerating the site via the pipeline rather than
# editing it by hand.
# ─────────────────────────────────────────────────────────────────────

# Bearer for hub callbacks (gisele.flyinggoatagency.com)
HUB_RPC_SECRET=

# Claude Agent SDK
ANTHROPIC_API_KEY=

# Vercel deploy automation
VERCEL_TOKEN=
VERCEL_TEAM_ID=
